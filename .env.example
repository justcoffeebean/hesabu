# Copy to .env and fill in what you use. Everything is optional for local use.
# Secrets live here, never in the app's Settings screen.

# --- Server ---------------------------------------------------------------
PORT=3000
# The https address people (and Safaricom) reach the app on. Needed for M-Pesa
# callbacks and for invite links. Cookies are marked Secure when this is https.
PUBLIC_URL=
# Set to 1 when running behind nginx/Caddy/a load balancer, so sign-in rate
# limiting and the audit log see the visitor's real IP.
TRUST_PROXY=
APP_TIMEZONE=Africa/Nairobi
# Fixed first-run setup code (otherwise a random one is printed at startup).
SETUP_CODE=
# Days a sign-in lasts without use, and the hard limit however much it's used.
SESSION_DAYS=7
SESSION_MAX_DAYS=30

# --- Database -------------------------------------------------------------
# Leave empty to use a SQLite file at data/hesabu.sqlite (nothing to install).
# For several users or a hosted server, use PostgreSQL:
# DATABASE_URL=postgres://hesabu:password@localhost:5432/hesabu
DATABASE_URL=

# --- Background jobs (recurring invoices, reminders) -----------------------
# Hour of the day (0-23, APP_TIMEZONE) after which daily jobs run.
JOBS_HOUR=8
JOBS_ENABLED=true

# --- Email (invoices, quotations, reminders, invite links) -----------------
# MAIL_TRANSPORT=log prints emails to the terminal instead of sending them.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zawadi Chemicals <accounts@zawadichem.co.ke>"

# --- SMS reminders (Africa's Talking) --------------------------------------
# SMS_TRANSPORT=log prints texts to the terminal instead of sending them.
SMS_TRANSPORT=log
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- M-Pesa (Safaricom Daraja) ---------------------------------------------
# Sandbox test values: shortcode 174379 and the passkey shown on the Daraja
# portal's "Lipa na M-Pesa Online" simulator page.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
# Paybill number, or for Buy Goods the store (head office) number.
DARAJA_SHORTCODE=
# paybill or till. For till, also set DARAJA_PARTY_B to the till number.
DARAJA_TYPE=paybill
DARAJA_PARTY_B=
# A long random string; it becomes part of the callback URLs Safaricom calls.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=
# Optional: comma-separated Safaricom callback IPs to accept (ask Safaricom for the current list).
DARAJA_ALLOWED_IPS=
